#!/usr/bin/env python3
"""git desc: Generate a commit message or release notes using an LLM.

Collects the diff between HEAD and its merge-base with the upstream (or
--base) plus git metadata, drops content that does not describe the change,
and sends the result to the 'ask' tool. When the input exceeds the context
budget, the diff is split into balanced parts that are summarized in
parallel, then combined.

Designed to work with the squash workflow: after 'git squash', run 'git desc'
to generate a meaningful commit message, then 'git commit --amend -F -'.
"""

import argparse
import ast
import concurrent.futures
import dataclasses
import functools
import math
import os
import re
import shutil
import subprocess
import sys
from collections.abc import Callable, Iterable

# Measured 3.3 characters per token on a 330 KB Go diff with both the o200k
# and Qwen3 tokenizers; 3 leaves a margin for denser content.
_CHARS_PER_TOKEN = 3
# Share of the context window kept for the prompt, reasoning and answer.
_RESERVED_SHARE = 0.25
_MIN_TOKENS = 8000
_CONTEXT_LINES = 10
_REDUCED_CONTEXT_LINES = 3
# Longer lines are truncated; they are usually minified or generated.
_MAX_LINE = 1000
_MAX_WORKERS = 4
_STAT_COUNT = 100

_DATA_EXTENSIONS = (".json", ".jsonl", ".ndjson", ".yaml", ".yml")
_LOCK_FILES = ("go.sum", "npm-shrinkwrap.json", "package-lock.json", "pnpm-lock.yaml")
_HUNK_RE = re.compile(r"^@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@(.*)$")


class Error(Exception):
    """A failure reported to the user without a traceback."""


@dataclasses.dataclass(frozen=True)
class Prompts:
    """Instructions for each kind of request."""

    whole: str  # Describe the complete diff.
    part: str  # Summarize one part of a split diff.
    final: str  # Describe the change from the part summaries.


_COMMIT_RULES = (
    "- Subject: imperative mood, no period, max 120 chars "
    '(e.g. "Fix timeout in retry loop")\n'
    "- Default to a body; omit it only for an obviously trivial, "
    "self-explanatory change such as a typo, formatting-only change, or "
    "comment-only change\n"
    "- Changes that affect behavior, interfaces, dependencies, data, "
    "architecture, or multiple meaningful concerns require a body after a "
    "blank line\n"
    "- Explain the rationale and consequential tradeoffs; do not merely "
    "restate the subject or diff\n"
    "- Wrap body lines at 80 columns\n"
    "- Match the style of recent upstream commits only when it does not "
    "conflict with these rules\n"
    "- Focus on the meaningful changes; ignore ancillary updates "
    "(imports, tests, build files, dependency bumps, formatting) "
    "unless they are the primary purpose of the change\n"
    "- No emojis\n"
    "- Output only the commit message, nothing else"
)

_RELEASE_RULES = (
    "- Categorize changes under headings: Features, Bug Fixes, "
    "Breaking Changes, Other (omit empty categories)\n"
    "- Each item is a concise bullet point describing the user-facing change\n"
    "- Derive information primarily from the commit messages, "
    "using the code changes for additional detail\n"
    "- Ignore internal refactors, test-only changes, and dependency bumps "
    "unless they affect users\n"
    "- No emojis\n"
    "- Output only the release notes, nothing else"
)

_COMMIT_PROMPTS = Prompts(
    whole="Write a git commit message for the change below. "
    "Follow these rules:\n" + _COMMIT_RULES,
    part="The input is one part of a larger change. Summarize what it "
    "changes and why in a few short paragraphs. Output only the summary.",
    final="Below are metadata and summaries of the parts of one change. "
    "Write a single git commit message for the change. "
    "Follow these rules:\n" + _COMMIT_RULES,
)

_RELEASE_PROMPTS = Prompts(
    whole="Write release notes in Markdown for the changes below. "
    "Follow these rules:\n" + _RELEASE_RULES,
    part="The input is one part of a larger release. Summarize its "
    "user-facing features, bug fixes, and breaking changes in a few short "
    "paragraphs. Output only the summary.",
    final="Below are metadata and summaries of the parts of one release. "
    "Write release notes in Markdown for the release. "
    "Follow these rules:\n" + _RELEASE_RULES,
)

_MERGE_PROMPT = (
    "Below are summaries of parts of one change. Merge them into one "
    "summary. Keep every distinct point and drop repetition. "
    "Output only the summary."
)


def _line_counts(lines: Iterable[str]) -> tuple[int, int]:
    """Return the old and new line counts of hunk body lines."""
    old = new = 0
    for line in lines:
        old += line[:1] in (" ", "-")
        new += line[:1] in (" ", "+")
    return old, new


@dataclasses.dataclass(frozen=True)
class Hunk:
    """One hunk of a file diff."""

    old_start: int
    new_start: int
    section: str  # Text after the closing "@@", usually the enclosing function.
    lines: tuple[str, ...]  # Body lines, each ending with a newline.

    def header(self) -> str:
        """Return the "@@" line with counts matching the body."""
        old, new = _line_counts(self.lines)
        return f"@@ -{self.old_start},{old} +{self.new_start},{new} @@{self.section}\n"

    def render(self) -> str:
        """Return the hunk as unified diff text."""
        return self.header() + "".join(self.lines)

    def with_context(self, n: int) -> "Hunk":
        """Return the hunk with at most n context lines around each change."""
        keep = [True] * len(self.lines)
        lead = 0
        i = 0
        while i < len(self.lines):
            if self.lines[i][:1] != " ":
                i += 1
                continue
            start = i
            while i < len(self.lines) and self.lines[i][:1] == " ":
                i += 1
            if start == 0:
                drop = range(i - n)
                lead = len(drop)
            elif i == len(self.lines):
                drop = range(start + n, i)
            else:
                drop = range(start + n, i - n)
            for k in drop:
                keep[k] = False
        lines = tuple(line for line, k in zip(self.lines, keep) if k)
        return Hunk(self.old_start + lead, self.new_start + lead, self.section, lines)

    def split(self, limit: int) -> list["Hunk"]:
        """Split between lines into hunks of at most limit chars each."""
        # Split hunks start at higher line numbers, which may add digits.
        room = limit - len(self.header()) - 8
        hunks: list[Hunk] = []
        old, new = self.old_start, self.new_start
        for group in pack(list(self.lines), room):
            hunks.append(Hunk(old, new, self.section, tuple(group)))
            old_count, new_count = _line_counts(group)
            old += old_count
            new += new_count
        return hunks


@dataclasses.dataclass(frozen=True)
class FileDiff:
    """The diff of one file."""

    path: str
    header: str  # The "diff --git" line and extended headers such as renames.
    hunks: tuple[Hunk, ...]
    omitted: bool = False  # True when the hunks were dropped.

    def render(self) -> str:
        """Return the file as unified diff text."""
        if self.omitted:
            return self.header + "(content omitted)\n"
        return self.header + "".join(h.render() for h in self.hunks)

    def omit(self) -> "FileDiff":
        """Return the file without its hunks."""
        if not self.hunks:
            return self
        return dataclasses.replace(self, hunks=(), omitted=True)

    def with_context(self, n: int) -> "FileDiff":
        """Return the file with at most n context lines around each change."""
        return dataclasses.replace(
            self, hunks=tuple(h.with_context(n) for h in self.hunks)
        )

    def split(self, limit: int) -> list[str]:
        """Render as pieces of at most limit chars, each starting with the header."""
        text = self.render()
        if len(text) <= limit:
            return [text]
        room = limit - len(self.header)
        hunks = [h.render() for big in self.hunks for h in big.split(room)]
        return [self.header + "".join(group) for group in pack(hunks, room)]


def _extract_path(diff_line: str) -> str:
    """Extract the file path from a "diff --git" line.

    Handles both prefixed ("diff --git a/foo b/foo") and noprefix
    ("diff --git foo foo") formats.
    """
    line = diff_line.rstrip("\n")
    prefix = "diff --git a/"
    if line.startswith(prefix):
        rest = line[len(prefix) :]
        if (len(rest) - 3) % 2 == 0:
            path_len = (len(rest) - 3) // 2
            if rest[path_len : path_len + 3] == " b/":
                old, new = rest[:path_len], rest[path_len + 3 :]
                if old == new:
                    return new
    payload = line.removeprefix("diff --git ")
    if payload.startswith('"'):
        escaped = False
        for i, char in enumerate(payload[1:], 1):
            if char == '"' and not escaped:
                return _decode_git_path(payload[i + 1 :].strip())
            escaped = char == "\\" and not escaped
            if char != "\\":
                escaped = False
    tokens = line.split()
    return _decode_git_path(tokens[-1]) if len(tokens) >= 4 else ""


def _decode_git_path(value: str) -> str:
    """Decode one path from Git's patch output and remove its a/ or b/ prefix."""
    if value.startswith('"'):
        try:
            escaped = ast.literal_eval(value)
            value = os.fsdecode(escaped.encode("latin1"))
        except (SyntaxError, ValueError, UnicodeError) as e:
            raise Error(f"Malformed quoted Git path: {value}") from e
    if value.startswith(("a/", "b/")):
        return value[2:]
    return value


def _clip(line: str) -> str:
    """Truncate a line to _MAX_LINE chars and end it with a newline."""
    line = line.rstrip("\n")
    if len(line) > _MAX_LINE:
        line = line[:_MAX_LINE] + " [truncated]"
    return line + "\n"


def _is_test_file(path: str) -> bool:
    return "test" in os.path.basename(path).lower()


def _is_data_file(path: str) -> bool:
    return os.path.splitext(path)[1].lower() in _DATA_EXTENSIONS


def _is_lock_file(path: str) -> bool:
    name = os.path.basename(path)
    return name in _LOCK_FILES or name.endswith(".lock")


def parse_diff(text: str) -> tuple[str, list[FileDiff]]:
    """Parse git diff output into the text before the first file and the files.

    Drops content that does not describe the change: index and ---/+++
    lines, deleted and lock file contents, and the tail of long lines.
    """
    preamble, *blocks = re.split(r"^(?=diff --git )", text, flags=re.MULTILINE)
    return preamble.strip(), [_parse_file(block) for block in blocks]


def _parse_file(block: str) -> FileDiff:
    first, *rest = block.splitlines(keepends=True)
    path = _extract_path(first)
    header = [_clip(first)]
    hunks: list[tuple[re.Match[str], list[str]]] = []
    for line in rest:
        if line.startswith("@@"):
            m = _HUNK_RE.match(line.rstrip("\n"))
            if not m:
                raise Error(f"Malformed hunk header in {path}: {line.rstrip()}")
            hunks.append((m, []))
        elif hunks:
            hunks[-1][1].append(_clip(line))
        elif line.startswith("+++ ") and line[4:].strip() != "/dev/null":
            path = _decode_git_path(line[4:].strip())
        elif line.startswith("rename to "):
            path = _decode_git_path(line[len("rename to ") :].strip())
        elif not line.startswith(("index ", "--- ", "+++ ")):
            header.append(_clip(line))
    f = FileDiff(
        path,
        "".join(header),
        tuple(Hunk(int(m[1]), int(m[2]), m[3], tuple(body)) for m, body in hunks),
    )
    if _is_lock_file(path) or "\ndeleted file mode " in f.header:
        return f.omit()
    return f


def pack(items: list[str], limit: int) -> list[list[str]]:
    """Group consecutive items into balanced groups of at most limit chars.

    An item longer than limit gets its own group.
    """
    total = sum(map(len, items))
    target = total / max(1, math.ceil(total / limit))
    groups: list[list[str]] = []
    size = 0
    for item in items:
        # Start a new group when the item would overflow the limit or when
        # most of it lands past the balanced target.
        if not groups or size + len(item) > limit or size + len(item) / 2 > target:
            groups.append([])
            size = 0
        groups[-1].append(item)
        size += len(item)
    return groups


def split_text(text: str, limit: int) -> list[str]:
    """Split text into pieces of at most limit chars at readable boundaries."""
    pieces: list[str] = []
    while len(text) > limit:
        end = max(text.rfind("\n", 0, limit + 1), text.rfind(" ", 0, limit + 1))
        if end <= 0:
            end = limit
        else:
            end += 1
        pieces.append(text[:end])
        text = text[end:]
    if text:
        pieces.append(text)
    return pieces


def split_diff(files: Iterable[FileDiff], limit: int) -> list[str]:
    """Split into balanced parts of at most limit chars, preferably between files."""
    pieces = [piece for f in files for piece in f.split(limit)]
    return ["".join(group) for group in pack(pieces, limit)]


_REDUCTIONS: tuple[tuple[str, Callable[[FileDiff], FileDiff]], ...] = (
    (
        f"reducing context to {_REDUCED_CONTEXT_LINES} lines",
        lambda f: f.with_context(_REDUCED_CONTEXT_LINES),
    ),
    ("omitting test files", lambda f: f.omit() if _is_test_file(f.path) else f),
    ("omitting JSON/YAML files", lambda f: f.omit() if _is_data_file(f.path) else f),
)


def reduce_diff(files: list[FileDiff], limit: int) -> list[FileDiff]:
    """Apply reductions in order until the rendered diff fits in limit chars."""
    for description, reduction in _REDUCTIONS:
        size = sum(len(f.render()) for f in files)
        if size <= limit:
            break
        print(f"Diff is {size} chars, over {limit}; {description}", file=sys.stderr)
        files = [reduction(f) for f in files]
    return files


@dataclasses.dataclass(frozen=True)
class Source:
    """The change to describe."""

    context: str  # Metadata sent with requests that describe the change.
    brief: str  # Shorter metadata sent with each part of a split diff.
    files: list[FileDiff]


def _section(title: str, body: str) -> str:
    return f"=== {title} ===\n{body.strip()}\n\n"


def _sections(*sections: tuple[str, str]) -> str:
    """Format the (title, body) pairs with a non-empty body."""
    return "".join(_section(title, body) for title, body in sections if body.strip())


def _git(*args: str) -> str:
    return subprocess.run(
        ["git", "-c", "core.quotePath=true", "-c", "color.ui=false", *args],
        capture_output=True,
        text=True,
        check=True,
    ).stdout


def _exclude(files: list[FileDiff], excludes: list[str]) -> list[FileDiff]:
    return [f for f in files if not f.path.startswith(tuple(excludes))]


def git_source(base: str | None, release: bool, excludes: list[str]) -> Source:
    """Collect the change from the merge-base with base (default: upstream) to HEAD."""
    ancestor = _git("merge-base", "HEAD", base or "@{upstream}").strip()
    rev_range = f"{ancestor}..HEAD"
    pathspecs = ["--", *(f":(top,exclude){e}" for e in excludes)]
    stat = _git(
        "diff",
        "--no-color",
        "--no-ext-diff",
        "--no-textconv",
        "--stat",
        "--stat-width=80",
        "--stat-name-width=60",
        f"--stat-count={_STAT_COUNT}",
        rev_range,
        *pathspecs,
    )
    diff = _git(
        "diff",
        "--no-color",
        "--no-ext-diff",
        "--no-textconv",
        "--patience",
        "--find-renames=50%",
        "--src-prefix=a/",
        "--dst-prefix=b/",
        "--output-indicator-new=+",
        "--output-indicator-old=-",
        "--output-indicator-context= ",
        "--submodule=short",
        "--no-relative",
        f"-U{_CONTEXT_LINES}",
        rev_range,
    )
    files = _exclude(parse_diff(diff)[1], excludes)
    if release:
        subjects = _git("log", "--reverse", "--format=%H %s", rev_range)
        messages = _git("log", "--reverse", "--format=--- %H %s%n%b", rev_range)
        return Source(
            context=_sections(("Files changed", stat), ("Commit messages", messages)),
            brief=_sections(("Files changed", stat), ("Commits", subjects)),
            files=files,
        )
    brief = _sections(
        ("Branch", _git("rev-parse", "--abbrev-ref", "HEAD")),
        ("Files changed", stat),
        ("Commits", _git("log", "-5", "--format=%H %s", rev_range)),
    )
    upstream = _git("log", "-5", "--format=%H %s", ancestor)
    return Source(
        context=brief + _sections(("Recent upstream commits", upstream)),
        brief=brief,
        files=files,
    )


def stdin_source(text: str, excludes: list[str]) -> Source:
    """Collect the change from diff text, such as 'git show' output."""
    preamble, files = parse_diff(text)
    context = _sections(("Input header", preamble))
    return Source(context=context, brief=context, files=_exclude(files, excludes))


Ask = Callable[[str, str], str]


def _ask(prompt: str, data: str, timeout: int) -> str:
    """Send data to the 'ask' tool with prompt and return its answer."""
    try:
        result = subprocess.run(
            ["ask", "-q", prompt],
            input=data,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired as e:
        raise Error(f"ask timed out after {timeout}s") from e
    answer = result.stdout.strip()
    if result.returncode or not answer:
        detail = result.stderr.strip() or "no output"
        raise Error(f"ask failed with exit code {result.returncode}: {detail}")
    return answer


def _ask_all(ask: Ask, prompt: str, inputs: list[str]) -> list[str]:
    """Send the inputs in parallel and return the answers in input order."""
    with concurrent.futures.ThreadPoolExecutor(_MAX_WORKERS) as pool:
        futures = [pool.submit(ask, prompt, data) for data in inputs]
        try:
            return [future.result() for future in futures]
        except Error:
            pool.shutdown(cancel_futures=True)
            raise


def _room(budget: int, overhead: str) -> int:
    """Return the chars left for content after overhead."""
    room = budget - len(overhead)
    if room < 4 * _MAX_LINE:
        raise Error(
            f"Metadata leaves {room} of {budget} chars for content; raise --tokens"
        )
    return room


def describe(source: Source, prompts: Prompts, budget: int, ask: Ask) -> str:
    """Describe the change with requests of at most budget chars of input each."""
    if not source.files:
        raise Error("No changes to describe")
    title = "Changes"
    files = reduce_diff(source.files, _room(budget, source.context + _section(title, "")))
    diff = "".join(f.render() for f in files)
    if len(diff) <= _room(budget, source.context + _section(title, "")):
        return ask(prompts.whole, source.context + _section(title, diff))

    title = "Partial changes"
    parts = split_diff(files, _room(budget, source.brief + _section(title, "")))
    print(f"Diff is {len(diff)} chars; splitting into {len(parts)} parts", file=sys.stderr)
    summaries = _ask_all(
        ask, prompts.part, [source.brief + _section(title, part) for part in parts]
    )

    title = "Part summaries"
    room = _room(budget, source.context + _section(title, ""))
    while True:
        items = [summary + "\n\n" for summary in summaries]
        size = sum(map(len, items))
        if size <= room:
            break
        pieces = [piece for item in items for piece in split_text(item, room)]
        groups = pack(pieces, room)
        print(
            f"Summaries are {size} chars, over {room}; merging into {len(groups)}",
            file=sys.stderr,
        )
        merged = _ask_all(ask, _MERGE_PROMPT, ["".join(group) for group in groups])
        if sum(map(len, merged)) >= sum(map(len, summaries)):
            raise Error("Merging summaries did not shorten them; raise --tokens")
        summaries = merged
    return ask(prompts.final, source.context + _section(title, "".join(items)))


def main() -> int:
    """Main entry point."""
    parser = argparse.ArgumentParser(
        description="Generate a commit message or release notes using an LLM."
    )
    parser.add_argument(
        "-b", "--base", help="base ref to diff against (default: upstream)"
    )
    parser.add_argument(
        "-e",
        "--exclude",
        action="append",
        default=[],
        metavar="PREFIX",
        help="path prefix to exclude from the diff (repeatable)",
    )
    parser.add_argument(
        "-r",
        "--release",
        action="store_true",
        help="generate release notes instead of a commit message",
    )
    parser.add_argument(
        "-t",
        "--tokens",
        type=int,
        default=os.environ.get("GIT_DESC_TOKENS", "64000"),
        help="model context window in tokens (default: $GIT_DESC_TOKENS or 64000)",
    )
    parser.add_argument(
        "--timeout",
        type=int,
        default=300,
        help="seconds to wait for each LLM request (default: 300)",
    )
    parser.add_argument(
        "--stdin",
        action="store_true",
        help="read the diff from stdin instead of computing it with git",
    )
    args = parser.parse_args()
    if args.stdin and (args.base or args.release):
        parser.error("--stdin excludes --base and --release")
    if args.tokens < _MIN_TOKENS:
        parser.error(f"--tokens must be at least {_MIN_TOKENS}")
    if not shutil.which("ask"):
        parser.error(
            "'ask' not found in PATH; install it with: "
            "go install github.com/maruel/ask@latest"
        )

    prompts = _RELEASE_PROMPTS if args.release else _COMMIT_PROMPTS
    budget = int(args.tokens * (1 - _RESERVED_SHARE) * _CHARS_PER_TOKEN)
    ask = functools.partial(_ask, timeout=args.timeout)
    try:
        if args.stdin:
            source = stdin_source(sys.stdin.read(), args.exclude)
        else:
            source = git_source(args.base, args.release, args.exclude)
        print(describe(source, prompts, budget, ask))
    except subprocess.CalledProcessError as e:
        print(f"{' '.join(e.cmd)}: {e.stderr.strip()}", file=sys.stderr)
        return 1
    except Error as e:
        print(e, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
