#!/usr/bin/env python3
"""git desc: Generate a commit description using an LLM.

Gathers the diff between the current branch and its upstream merge-base,
along with context (branch name, changed files, recent upstream commits),
and sends it to the 'ask' tool to generate a commit message.

Designed to work with the squash workflow: after 'git squash', run 'git desc'
to generate a meaningful commit message, then 'git commit --amend -F -'.
"""

import argparse
import concurrent.futures
import os
import re
import shutil
import subprocess
import sys
import traceback
import typing


class _Prompts(typing.NamedTuple):
    main: str
    chunk: str
    summary: str


_COMMIT_PROMPTS = _Prompts(
    main=(
        "Write a git commit message for the changes below. Follow these rules:\n"
        "- Subject: imperative mood, no period, max 72 chars "
        '(e.g. "Fix timeout in retry loop")\n'
        "- If the change is non-trivial, add a blank line then a body "
        "explaining what and why, not how\n"
        "- Wrap body lines at 72 chars\n"
        "- Match the style of recent upstream commits if provided\n"
        "- Focus on the meaningful changes; ignore ancillary updates "
        "(imports, test data, build files, dependency bumps, formatting) "
        "unless they are the primary purpose of the commit\n"
        "- No emojis\n"
        "- Output only the commit message, nothing else"
    ),
    chunk=(
        "Summarize the following code changes in a few paragraphs. "
        "Focus on what changed and why. Output a brief description."
    ),
    summary=(
        "Below are descriptions of different parts of the same commit. "
        "Write a single unified git commit message following these rules:\n"
        "- Subject: imperative mood, no period, max 72 chars\n"
        "- If non-trivial, add a blank line then a body explaining what and why\n"
        "- Wrap body lines at 72 chars\n"
        "- No emojis\n"
        "- Output only the commit message, nothing else"
    ),
)

_RELEASE_PROMPTS = _Prompts(
    main=(
        "Write release notes for the changes below in Markdown. Follow these rules:\n"
        "- Categorize changes under headings: Features, Bug Fixes, Breaking Changes, "
        "Other (omit empty categories)\n"
        "- Each item is a concise bullet point describing the user-facing change\n"
        "- Derive information primarily from the commit messages, "
        "using the diff for additional detail\n"
        "- Ignore internal refactors, test-only changes, and dependency bumps "
        "unless they affect users\n"
        "- No emojis\n"
        "- Output only the release notes, nothing else"
    ),
    chunk=(
        "Summarize the following code changes for release notes. "
        "Focus on user-facing features, bug fixes, and breaking changes. "
        "Output a brief description."
    ),
    summary=(
        "Below are summaries of different parts of the same release. "
        "Write unified release notes in Markdown following these rules:\n"
        "- Categorize under headings: Features, Bug Fixes, Breaking Changes, "
        "Other (omit empty categories)\n"
        "- Each item is a concise bullet point describing the user-facing change\n"
        "- No emojis\n"
        "- Output only the release notes, nothing else"
    ),
)

# While many models support 200k tokens, some providers like Cerebras and Groq have models
# that only support 120k tokens.
# The number of chacters is in theory larger than this but in practice this
# is a safe limit since code likely requires more tokens to encode than normal
# text.
_MAX_CONTEXT = 100_000

_HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@(.*)$")


def run_git_command(
    cmd: typing.List[str], check: bool = True
) -> typing.Tuple[str, int]:
    """Run a git command and return output and return code."""
    result = subprocess.run(cmd, capture_output=True, text=True, check=check)
    return result.stdout.strip(), result.returncode


def get_ancestor(base: typing.Optional[str]) -> typing.Optional[str]:
    """Get the ancestor (merge-base) between HEAD and base ref or upstream."""
    if base:
        # Verify the ref exists.
        _, rc = run_git_command(["git", "rev-parse", "--verify", base], check=False)
        if rc != 0:
            print(f"Invalid ref: {base}", file=sys.stderr)
            return None
        ancestor, rc = run_git_command(["git", "merge-base", "HEAD", base], check=False)
        return None if rc != 0 else ancestor
    _, rc = run_git_command(["git", "rev-parse", "--abbrev-ref", "@{u}"], check=False)
    if rc != 0:
        return None
    ancestor, rc = run_git_command(["git", "merge-base", "HEAD", "@{u}"], check=False)
    return None if rc != 0 else ancestor


def _extract_path(diff_line: str) -> str:
    """Extract the file path from a 'diff --git' line.

    Handles both prefixed ("diff --git a/foo b/foo") and noprefix
    ("diff --git foo foo") formats.
    """
    # Try standard a/ b/ prefix first.
    parts = diff_line.split(" b/", 1)
    if len(parts) == 2:
        return parts[1].rstrip()
    # Noprefix: "diff --git foo bar" — take the last space-separated token.
    tokens = diff_line.rstrip().split()
    return tokens[-1] if len(tokens) >= 4 else ""


def _filter_diff(diff: str, should_exclude: typing.Callable[[str], bool]) -> str:
    """Filter a unified diff, dropping hunks for files matching predicate."""
    chunks: typing.List[str] = []
    current: typing.List[str] = []
    skip = False
    for line in diff.splitlines(True):
        if line.startswith("diff --git "):
            if current and not skip:
                chunks.append("".join(current))
            current = [line]
            path = _extract_path(line)
            skip = should_exclude(path)
        else:
            current.append(line)
    if current and not skip:
        chunks.append("".join(current))
    return "".join(chunks)


def filter_diff(diff: str, excludes: typing.List[str]) -> str:
    """Filter a unified diff, dropping hunks for files matching excludes."""
    if not excludes:
        return diff
    return _filter_diff(diff, lambda p: any(p.startswith(e) for e in excludes))


def _is_test_file(path: str) -> bool:
    """Check if a path looks like a test file."""
    return "test" in os.path.basename(path).lower()


def _is_data_file(path: str) -> bool:
    """Check if a path is a JSON or YAML file."""
    return os.path.splitext(path)[1].lower() in (
        ".json",
        ".jsonl",
        ".ndjson",
        ".yaml",
        ".yml",
    )


def _trim_hunk_context(
    body: typing.List[str], target: int
) -> typing.Tuple[typing.List[str], int]:
    """Trim context lines in a hunk body to at most *target* per side.

    Returns (trimmed_lines, leading_context_lines_removed).
    """
    if not body:
        return body, 0

    is_ctx = [line[:1] == " " for line in body]

    # Identify runs of consecutive context lines: (start, end).
    runs: typing.List[typing.Tuple[int, int]] = []
    j = 0
    while j < len(body):
        if is_ctx[j]:
            start = j
            while j < len(body) and is_ctx[j]:
                j += 1
            runs.append((start, j))
        else:
            j += 1

    if not runs:
        return body, 0

    keep = [True] * len(body)
    lead_cut = 0

    for start, end in runs:
        run_len = end - start
        at_top = start == 0
        at_bottom = end == len(body)
        if at_top:
            # Leading context — keep last *target* lines.
            excess = run_len - target
            if excess > 0:
                for k in range(start, start + excess):
                    keep[k] = False
                lead_cut = excess
        elif at_bottom:
            # Trailing context — keep first *target* lines.
            if run_len > target:
                for k in range(start + target, end):
                    keep[k] = False
        else:
            # Middle context — keep first *target* + last *target*.
            if run_len > 2 * target:
                for k in range(start + target, end - target):
                    keep[k] = False

    trimmed = [line for line, k in zip(body, keep) if k]
    return trimmed, lead_cut


def _reduce_diff_context(diff: str, target: int) -> str:
    """Reduce context lines in a unified diff to *target* lines per hunk side."""
    result: typing.List[str] = []
    lines = diff.splitlines(True)
    i = 0
    while i < len(lines):
        line = lines[i]
        # Pass through everything that is not a hunk header.
        if not line.startswith("@@"):
            result.append(line)
            i += 1
            continue

        m = _HUNK_RE.match(line.rstrip("\n\r"))
        if not m:
            result.append(line)
            i += 1
            continue

        old_start = int(m.group(1))
        new_start = int(m.group(3))
        func_ctx = m.group(5)

        # Collect hunk body (until next hunk header or file header).
        i += 1
        body: typing.List[str] = []
        while i < len(lines) and not lines[i].startswith(("diff --git ", "@@")):
            body.append(lines[i])
            i += 1

        trimmed, lead_cut = _trim_hunk_context(body, target)
        if not trimmed:
            continue

        old_start += lead_cut
        new_start += lead_cut
        old_count = sum(1 for l in trimmed if l[:1] in (" ", "-"))
        new_count = sum(1 for l in trimmed if l[:1] in (" ", "+"))
        result.append(
            f"@@ -{old_start},{old_count} +{new_start},{new_count} @@{func_ctx}\n"
        )
        result.extend(trimmed)
    return "".join(result)


def _gather_metadata(ancestor: str, excludes: typing.List[str]) -> str:
    """Gather non-diff git metadata for the LLM prompt."""
    parts: typing.List[str] = []
    pathspecs = ["--"] + [f":(exclude){e}" for e in excludes] if excludes else []

    branch, _ = run_git_command(["git", "rev-parse", "--abbrev-ref", "HEAD"])
    parts.append(f"=== Branch ===\n{branch}\n")

    stat, _ = run_git_command(
        ["git", "diff", "--stat", f"{ancestor}..HEAD"] + pathspecs
    )
    parts.append(f"=== Files Changed ===\n{stat}\n")

    log, _ = run_git_command(["git", "log", "-5", "--oneline", f"{ancestor}..HEAD"])
    if log:
        parts.append(f"=== Commits ===\n{log}\n")

    upstream_log, _ = run_git_command(["git", "log", "-5", "--oneline", ancestor])
    parts.append(f"=== Recent Upstream Commits ===\n{upstream_log}\n")

    return "\n".join(parts)


def _gather_release_metadata(ancestor: str, excludes: typing.List[str]) -> str:
    """Gather metadata for release notes, including all commit messages."""
    parts: typing.List[str] = []
    pathspecs = ["--"] + [f":(exclude){e}" for e in excludes] if excludes else []

    stat, _ = run_git_command(
        ["git", "diff", "--stat", f"{ancestor}..HEAD"] + pathspecs
    )
    parts.append(f"=== Files Changed ===\n{stat}\n")

    log, _ = run_git_command(
        ["git", "log", "--reverse", "--format=%h %s", f"{ancestor}..HEAD"]
    )
    if log:
        parts.append(f"=== Commits ===\n{log}\n")

    full_log, _ = run_git_command(
        [
            "git",
            "log",
            "--reverse",
            "--format=--- %h %s ---%n%b",
            f"{ancestor}..HEAD",
        ]
    )
    if full_log:
        parts.append(f"=== Full Commit Messages ===\n{full_log}\n")

    return "\n".join(parts)


def _get_diff(ancestor: str, excludes: typing.List[str], diff_context: int) -> str:
    """Get the diff between ancestor and HEAD."""
    pathspecs = ["--"] + [f":(exclude){e}" for e in excludes] if excludes else []
    diff, _ = run_git_command(
        [
            "git",
            "-c",
            "diff.noprefix=false",
            "diff",
            "--patience",
            f"-U{diff_context}",
            f"{ancestor}..HEAD",
        ]
        + pathspecs
    )
    return diff


def _build_context(metadata: str, diff: str) -> str:
    """Combine metadata and diff into full LLM context."""
    if metadata:
        return metadata + f"=== Changes ===\n{diff}"
    return f"=== Changes ===\n{diff}"


def _split_diff(diff: str, max_chunk: int) -> typing.List[str]:
    """Split a diff into chunks at file boundaries."""
    # Parse into per-file diffs.
    file_diffs: typing.List[str] = []
    current: typing.List[str] = []
    for line in diff.splitlines(True):
        if line.startswith("diff --git ") and current:
            file_diffs.append("".join(current))
            current = [line]
        else:
            current.append(line)
    if current:
        file_diffs.append("".join(current))

    # Group file diffs into chunks under max_chunk chars.
    chunks: typing.List[str] = []
    chunk: typing.List[str] = []
    chunk_size = 0
    for fd in file_diffs:
        if chunk_size + len(fd) > max_chunk and chunk:
            chunks.append("".join(chunk))
            chunk = [fd]
            chunk_size = len(fd)
        else:
            chunk.append(fd)
            chunk_size += len(fd)
    if chunk:
        chunks.append("".join(chunk))
    return chunks if chunks else [diff]


def _call_ask(prompt: str, context: str, timeout: int = 30) -> typing.Optional[str]:
    """Call the ask tool and return its output, or None on failure."""
    try:
        result = subprocess.run(
            ["ask", "-q", prompt],
            input=context,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return None
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return result.stdout.strip()


def _parallel_describe(metadata: str, diff: str, prompts: _Prompts) -> int:
    """Split diff into chunks, describe each in parallel, then summarize."""
    overhead = len(metadata) + 200
    max_chunk = max(_MAX_CONTEXT - overhead, _MAX_CONTEXT // 2)
    chunks = _split_diff(diff, max_chunk)

    print(
        f"Diff too large, splitting into {len(chunks)} chunks...",
        file=sys.stderr,
    )

    descriptions: typing.List[typing.Tuple[int, str]] = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=min(len(chunks), 4)) as pool:
        futures = {}
        for i, chunk in enumerate(chunks):
            ctx = _build_context(metadata, f"(part {i + 1}/{len(chunks)})\n{chunk}")
            futures[pool.submit(_call_ask, prompts.chunk, ctx, 60)] = i

        for future in concurrent.futures.as_completed(futures):
            idx = futures[future]
            try:
                result = future.result()
                if result:
                    descriptions.append((idx, result))
            except (OSError, subprocess.SubprocessError):
                pass

    if not descriptions:
        print("Failed to generate descriptions for any chunk", file=sys.stderr)
        return 1

    descriptions.sort()
    summaries = "\n\n".join(f"Part {idx + 1}:\n{desc}" for idx, desc in descriptions)
    final = _call_ask(prompts.summary, summaries)
    if not final:
        print("Failed to generate final summary", file=sys.stderr)
        return 1
    print(final)
    return 0


def main() -> int:
    """Main entry point."""
    try:
        parser = argparse.ArgumentParser(
            description="Generate a commit description using an LLM."
        )
        parser.add_argument(
            "-b",
            "--base",
            help="base ref to diff against (default: upstream merge-base)",
        )
        parser.add_argument(
            "-c",
            "--context",
            type=int,
            default=10,
            help="lines of diff context (default: 10)",
        )
        parser.add_argument(
            "-e",
            "--exclude",
            action="append",
            default=[],
            help="path prefix to exclude from diff (can be repeated)",
        )
        parser.add_argument(
            "-r",
            "--release",
            action="store_true",
            help="generate release notes instead of a commit message",
        )
        parser.add_argument(
            "--stdin",
            action="store_true",
            help="read diff from stdin instead of computing from git",
        )
        args = parser.parse_args()
        if args.stdin and args.base:
            parser.error("--stdin and --base are mutually exclusive")
        if args.stdin and args.release:
            parser.error("--stdin and --release are mutually exclusive")

        if not shutil.which("ask"):
            print("'ask' tool not found in PATH", file=sys.stderr)
            print(
                "Install it with: go install github.com/maruel/ask@latest",
                file=sys.stderr,
            )
            return 1

        if args.stdin:
            raw = sys.stdin.read()
            if not raw.strip():
                print("Empty input on stdin", file=sys.stderr)
                return 1
            diff = filter_diff(raw, args.exclude)
            metadata = ""
        else:
            output, rc = run_git_command(
                ["git", "rev-parse", "--show-toplevel"], check=False
            )
            if rc != 0:
                print("Not in a git repository", file=sys.stderr)
                return 1
            os.chdir(output)
            branch, rc = run_git_command(
                ["git", "rev-parse", "--abbrev-ref", "HEAD"], check=False
            )
            if rc != 0 or branch == "HEAD":
                print("Not on a branch (detached HEAD state)", file=sys.stderr)
                return 1
            ancestor = get_ancestor(args.base)
            if not ancestor:
                if args.base:
                    return 1
                print(
                    f"No upstream branch configured for '{branch}'.\n"
                    "Set an upstream with: "
                    "git branch --set-upstream-to=<upstream>",
                    file=sys.stderr,
                )
                return 1
            commits_count, _ = run_git_command(
                ["git", "rev-list", "--count", f"{ancestor}..HEAD"]
            )
            if commits_count == "0":
                print("No commits to describe", file=sys.stderr)
                return 1
            if args.release:
                metadata = _gather_release_metadata(ancestor, args.exclude)
            else:
                metadata = _gather_metadata(ancestor, args.exclude)
            diff = _get_diff(ancestor, args.exclude, args.context)

        # Step 1: reduce diff context lines to 3.
        if len(_build_context(metadata, diff)) > _MAX_CONTEXT:
            print(
                "Diff too large, reducing context to 3 lines...",
                file=sys.stderr,
            )
            diff = _reduce_diff_context(diff, 3)

        # Step 2: drop test files from diff.
        if len(_build_context(metadata, diff)) > _MAX_CONTEXT:
            print("Diff too large, excluding test files...", file=sys.stderr)
            diff = _filter_diff(diff, _is_test_file)

        # Step 3: drop JSON/YAML files from diff.
        if len(_build_context(metadata, diff)) > _MAX_CONTEXT:
            print(
                "Diff too large, excluding JSON/YAML files...",
                file=sys.stderr,
            )
            diff = _filter_diff(diff, _is_data_file)

        context = _build_context(metadata, diff)

        prompts = _RELEASE_PROMPTS if args.release else _COMMIT_PROMPTS

        # Step 4: split into chunks and parallelize.
        if len(context) > _MAX_CONTEXT:
            return _parallel_describe(metadata, diff, prompts)

        result = subprocess.run(
            ["ask", "-q", prompts.main],
            input=context,
            capture_output=True,
            text=True,
            timeout=30,
            check=False,
        )
        if result.returncode != 0 or not result.stdout.strip():
            print("Failed to generate output", file=sys.stderr)
            if result.stderr:
                print(result.stderr, file=sys.stderr)
            return 1
        print(result.stdout.strip())
        return 0
    except subprocess.TimeoutExpired:
        print("Timed out waiting for LLM response", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as e:
        tb = traceback.extract_tb(e.__traceback__)
        frame = None
        for i, f in enumerate(tb):
            if f.name == "run_git_command" and i > 0:
                frame = tb[i - 1]
                break
        if frame:
            print(f"Error in {frame.name}() at line {frame.lineno}:", file=sys.stderr)
        print(f"Command failed: {' '.join(e.cmd)}", file=sys.stderr)
        if e.stdout:
            print(f"stdout: {e.stdout}", file=sys.stderr)
        if e.stderr:
            print(f"stderr: {e.stderr}", file=sys.stderr)
        return e.returncode


if __name__ == "__main__":
    sys.exit(main())
